# ==============================================================================
# DentaCall Environment Variables
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=dentacall
POSTGRES_PASSWORD=dentacall_password
POSTGRES_DB=dentacall
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dentacall:dentacall_password@localhost:5432/dentacall
DATABASE_URL_SYNC=postgresql+psycopg://dentacall:dentacall_password@localhost:5432/dentacall

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Clinic Location & Regional Rules
CLINIC_TIMEZONE=Europe/Dublin
CLINIC_NAME="Grand Canal Dental Clinic"
CLINIC_PHONE="+35312345678"
CLINIC_EMAIL="reception@grandcanaldental.ie"

# Internal Service Auth
API_KEY=dev_secret_internal_api_key_replace_in_prod

# LLM Providers (Stage 3+)
# Set at least one provider key depending on configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic

# Voice & Audio Pipeline (Stage 5+)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Telephony (Stage 6+)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
LIVEKIT_SIP_URI=
EMERGENCY_TRANSFER_NUMBER=+35312349999
CLINIC_ESCALATION_NUMBER=+35312345679
MAX_CONCURRENT_CALLS=10
DAILY_SPEND_CAP_USD=25.0
CALL_RECORDING_NOTICE_ENABLED=true

# Observability (Stage 7+)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DATA_RETENTION_DAYS=90
